{
  "manifest_version": 3,
  "name": "Tubelens Vision",
  "version": "0.1.0",
  "description": "YouTube overlays for SEO scores, keyword research, and competitor intel — Tubelens Max.",
  "action": {
    "default_title": "Tubelens",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
